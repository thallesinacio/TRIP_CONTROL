<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tripcontrol.view.ItinerarioViewController"
      spacing="20.0">

    <!-- Pesquisa do pacote (UC06, passos 2 e 3) -->
    <VBox styleClass="cartao" spacing="12.0">
        <padding>
            <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
        </padding>

        <Label text="Buscar Pacote" styleClass="rotulo-campo"/>
        <HBox spacing="14.0" alignment="CENTER_LEFT">
            <TextField fx:id="txtTermoPacote" HBox.hgrow="ALWAYS"
                       promptText="Digite o código (ex: PC-105), destino ou data..."/>
            <Button fx:id="btnBuscarPacote" text="Buscar" onAction="#aoBuscarPacote"
                    defaultButton="true" styleClass="botao-primario"/>
        </HBox>

        <Label fx:id="lblMensagemPesquisa" styleClass="mensagem-erro" wrapText="true"
               managed="false" visible="false"/>

        <!-- So aparece quando a busca devolve mais de um pacote (passo 3). -->
        <VBox fx:id="painelResultados" spacing="6.0" managed="false" visible="false">
            <Label text="Selecione o pacote desejado" styleClass="rotulo-campo"/>
            <TableView fx:id="tablePacotes" prefHeight="140.0">
                <columns>
                    <TableColumn fx:id="colPacoteCodigo" text="Código" prefWidth="110.0"/>
                    <TableColumn fx:id="colPacoteDestino" text="Destino" prefWidth="280.0"/>
                    <TableColumn fx:id="colPacotePeriodo" text="Período" prefWidth="220.0"/>
                    <TableColumn fx:id="colPacoteVagas" text="Vagas Restantes" prefWidth="140.0"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

    <!-- Pacote selecionado (UC06, passo 4) -->
    <VBox fx:id="painelPacote" styleClass="cartao" spacing="8.0" managed="false" visible="false">
        <padding>
            <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label fx:id="lblCodigoPacote" text="-" styleClass="codigo-pacote"/>
            <Label fx:id="lblDestinoPacote" text="-" styleClass="titulo-secao"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAlterarPacote" text="Alterar Pacote" onAction="#aoAlterarPacote"
                    styleClass="botao-secundario"/>
        </HBox>
        <Label fx:id="lblPeriodoPacote" text="-" styleClass="texto-secundario"/>
    </VBox>

    <GridPane fx:id="painelMontagem" hgap="24.0" managed="false" visible="false">
        <columnConstraints>
            <ColumnConstraints percentWidth="58.0"/>
            <ColumnConstraints percentWidth="42.0"/>
        </columnConstraints>

        <!-- Cronograma atual (UC06, passo 4) -->
        <VBox GridPane.columnIndex="0" styleClass="cartao" spacing="14.0">
            <padding>
                <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
            </padding>
            <Label text="Cronograma Atual do Roteiro" styleClass="titulo-secao"/>
            <VBox fx:id="listaCronograma" spacing="12.0"/>
            <Label fx:id="lblCronogramaVazio" wrapText="true" styleClass="nota-calculo"
                   text="Nenhum item no cronograma ainda. Use o painel ao lado para adicionar hospedagens, transportes e atividades."/>
        </VBox>

        <!-- Adicionar item (UC06, passos 5 a 7) -->
        <VBox GridPane.columnIndex="1" styleClass="cartao" spacing="12.0">
            <padding>
                <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
            </padding>
            <Label text="Adicionar Item ao Cronograma" styleClass="titulo-secao"/>

            <VBox spacing="6.0">
                <Label text="Tipo de Evento" styleClass="rotulo-campo"/>
                <ComboBox fx:id="cboTipoEvento" maxWidth="Infinity" promptText="Selecione o tipo"/>
                <Label fx:id="lblErroTipo" styleClass="mensagem-erro" wrapText="true"
                       managed="false" visible="false"/>
            </VBox>

            <!--
                O protótipo usa texto livre em "Nome do Serviço", mas o passo 5 do UC06
                exige escolher um registro já cadastrado: o campo virou lista, com atalho
                de cadastro (FA02).
            -->
            <VBox spacing="6.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Nome do Serviço / Serviço Prestado" styleClass="rotulo-campo"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink fx:id="lnkCadastrarRecurso" text="Cadastrar novo"
                               onAction="#aoCadastrarRecurso" styleClass="botao-link"/>
                </HBox>
                <ComboBox fx:id="cboRecurso" maxWidth="Infinity"
                          promptText="Selecione o registro cadastrado"/>
                <Label fx:id="lblErroRecurso" styleClass="mensagem-erro" wrapText="true"
                       managed="false" visible="false"/>
            </VBox>

            <GridPane hgap="12.0" vgap="6.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>

                <VBox spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label fx:id="lblRotuloInicio" text="Data / Hora Saída" styleClass="rotulo-campo"/>
                    <DatePicker fx:id="dpDataInicio" maxWidth="Infinity"/>
                    <TextField fx:id="txtHoraInicio" promptText="HH:MM"/>
                </VBox>
                <VBox fx:id="painelFim" spacing="6.0" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label fx:id="lblRotuloFim" text="Data / Hora Chegada" styleClass="rotulo-campo"/>
                    <DatePicker fx:id="dpDataFim" maxWidth="Infinity"/>
                    <TextField fx:id="txtHoraFim" promptText="HH:MM"/>
                </VBox>
            </GridPane>
            <Label fx:id="lblErroInicio" styleClass="mensagem-erro" wrapText="true"
                   managed="false" visible="false"/>
            <Label fx:id="lblErroFim" styleClass="mensagem-erro" wrapText="true"
                   managed="false" visible="false"/>

            <GridPane fx:id="painelLocais" hgap="12.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0"/>
                    <ColumnConstraints percentWidth="50.0"/>
                </columnConstraints>
                <VBox fx:id="painelOrigem" spacing="6.0" GridPane.columnIndex="0">
                    <Label text="Local de Origem" styleClass="rotulo-campo"/>
                    <TextField fx:id="txtLocalOrigem" promptText="Ex: Aeroporto POA"/>
                    <Label fx:id="lblErroLocalOrigem" styleClass="mensagem-erro" wrapText="true"
                           managed="false" visible="false"/>
                </VBox>
                <VBox fx:id="painelDestino" spacing="6.0" GridPane.columnIndex="1">
                    <Label fx:id="lblRotuloDestino" text="Local de Destino" styleClass="rotulo-campo"/>
                    <TextField fx:id="txtLocalDestino" promptText="Ex: Hotel Laghetto"/>
                    <Label fx:id="lblErroLocalDestino" styleClass="mensagem-erro" wrapText="true"
                           managed="false" visible="false"/>
                </VBox>
            </GridPane>

            <VBox spacing="6.0">
                <Label text="Instruções Operacionais" styleClass="rotulo-campo"/>
                <TextArea fx:id="txtInstrucoes" prefRowCount="3" wrapText="true"
                          promptText="Adicione contatos, número da reserva operacional, e orientações de bagagem..."/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnAdicionarItem" text="Adicionar ao Itinerário"
                    onAction="#aoAdicionarItem" maxWidth="Infinity" styleClass="botao-primario"/>
        </VBox>
    </GridPane>

    <!-- Rodape (UC06, passos 10 e 11; FA07) -->
    <HBox fx:id="rodapeItinerario" alignment="CENTER_LEFT" spacing="14.0"
          managed="false" visible="false">
        <Label text="* Certifique-se de salvar ou finalizar antes de emitir vouchers aos passageiros."
               wrapText="true" styleClass="aviso-politicas"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancelarItinerario" text="Cancelar Itinerário"
                onAction="#aoCancelarItinerario" styleClass="botao-perigo"/>
        <Button fx:id="btnFinalizarItinerario" text="Finalizar Itinerário"
                onAction="#aoFinalizarItinerario" styleClass="botao-primario"/>
    </HBox>
</VBox>
