<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<GridPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.tripcontrol.view.LoginController"
          styleClass="tela-login">
    <columnConstraints>
        <ColumnConstraints percentWidth="42.0"/>
        <ColumnConstraints percentWidth="58.0"/>
    </columnConstraints>

    <!-- Painel de marca -->
    <VBox styleClass="painel-marca" spacing="24.0" GridPane.columnIndex="0">
        <padding>
            <Insets top="56.0" right="48.0" bottom="56.0" left="48.0"/>
        </padding>
        <HBox spacing="12.0" styleClass="marca-topo">
            <Label text="T" styleClass="marca-icone"/>
            <Label text="TripControl" styleClass="marca-nome"/>
        </HBox>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox spacing="16.0" styleClass="cartao-marca">
            <padding>
                <Insets top="32.0" right="28.0" bottom="32.0" left="28.0"/>
            </padding>
            <Label text="A gestao da sua agencia, mais leve e organizada." wrapText="true"
                   styleClass="marca-titulo"/>
            <Label text="Pacotes, reservas, pagamentos e roteiros em um unico lugar, mesmo sem conexao."
                   wrapText="true" styleClass="marca-subtitulo"/>
            <Label text="Dados locais e seguros" styleClass="selo-local"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- Formulario -->
    <VBox styleClass="painel-formulario" spacing="8.0" GridPane.columnIndex="1" alignment="CENTER_LEFT">
        <padding>
            <Insets top="56.0" right="72.0" bottom="56.0" left="72.0"/>
        </padding>
        <Label text="BEM-VINDO DE VOLTA" styleClass="rotulo-secao-destaque"/>
        <Label text="Entre na sua conta" styleClass="titulo-principal"/>
        <Label text="Use suas credenciais para acessar o painel TripControl." styleClass="texto-secundario"/>

        <VBox spacing="6.0" styleClass="grupo-campo">
            <padding>
                <Insets top="28.0"/>
            </padding>
            <Label text="E-mail" styleClass="rotulo-campo"/>
            <TextField fx:id="txtEmail" promptText="seu.email@tripcontrol.com"/>
        </VBox>

        <VBox spacing="6.0" styleClass="grupo-campo">
            <padding>
                <Insets top="14.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Senha" styleClass="rotulo-campo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Esqueci minha senha" onAction="#aoEsquecerSenha" styleClass="link-discreto"/>
            </HBox>
            <PasswordField fx:id="txtSenha" promptText="Sua senha"/>
        </VBox>

        <CheckBox fx:id="chkLembrarDispositivo" text="Lembrar de mim neste dispositivo">
            <VBox.margin>
                <Insets top="16.0"/>
            </VBox.margin>
        </CheckBox>

        <Label fx:id="lblMensagemErro" styleClass="mensagem-erro" wrapText="true" managed="false" visible="false">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
        </Label>

        <Button fx:id="btnEntrar" text="Entrar no TripControl" onAction="#aoEntrar"
                maxWidth="Infinity" defaultButton="true" styleClass="botao-primario">
            <VBox.margin>
                <Insets top="20.0"/>
            </VBox.margin>
        </Button>

        <Label fx:id="lblDicaDemonstracao" styleClass="texto-rodape" wrapText="true">
            <VBox.margin>
                <Insets top="24.0"/>
            </VBox.margin>
        </Label>
        <Label text="TripControl - Sistema local de gestao de agencia" styleClass="texto-rodape"/>
    </VBox>
</GridPane>
