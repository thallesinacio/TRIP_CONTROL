<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.tripcontrol.view.PrincipalController"
            styleClass="janela-principal">

    <!-- Menu lateral -->
    <left>
        <VBox styleClass="menu-lateral" spacing="4.0" prefWidth="240.0">
            <padding>
                <Insets top="24.0" right="16.0" bottom="20.0" left="16.0"/>
            </padding>
            <VBox spacing="2.0" styleClass="menu-marca">
                <Label text="TripControl" styleClass="menu-marca-nome"/>
                <Label text="JAVAFX SUITE" styleClass="menu-marca-sub"/>
                <padding>
                    <Insets bottom="24.0" left="8.0"/>
                </padding>
            </VBox>

            <ToggleButton fx:id="btnMenuPacotes" text="Pacotes" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuClientes" text="Clientes" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuReservas" text="Reservas" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuVagas" text="Vagas" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuPagamentos" text="Pagamentos" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuItinerarios" text="Itinerarios" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuCancelamentos" text="Cancelamentos" maxWidth="Infinity" styleClass="item-menu"/>
            <ToggleButton fx:id="btnMenuRelatorios" text="Relatorios" maxWidth="Infinity" styleClass="item-menu"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Dados em memoria (banco pendente)" styleClass="status-banco" wrapText="true"/>
            <Label text="v0.1.0 - JDK 21" styleClass="status-versao"/>
        </VBox>
    </left>

    <!-- Cabecalho -->
    <top>
        <HBox styleClass="cabecalho" alignment="CENTER_LEFT" spacing="16.0">
            <padding>
                <Insets top="22.0" right="32.0" bottom="22.0" left="32.0"/>
            </padding>
            <VBox spacing="4.0">
                <Label fx:id="lblTituloTela" text="TripControl" styleClass="titulo-tela"/>
                <Label fx:id="lblSubtituloTela" text="" styleClass="subtitulo-tela"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUsuarioLogado" text="" styleClass="chip-usuario"/>
            <Button text="Sair" onAction="#aoSair" styleClass="botao-secundario"/>
        </HBox>
    </top>

    <!-- Conteudo -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="area-rolagem">
            <content>
                <StackPane fx:id="areaConteudo" styleClass="area-conteudo">
                    <padding>
                        <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
                    </padding>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
