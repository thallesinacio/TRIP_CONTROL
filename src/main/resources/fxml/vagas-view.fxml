<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<GridPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.tripcontrol.view.VagasController"
          hgap="24.0">
    <columnConstraints>
        <ColumnConstraints percentWidth="62.0"/>
        <ColumnConstraints percentWidth="38.0"/>
    </columnConstraints>

    <!-- Listagem de pacotes com ocupação (UC04, passo 2) -->
    <StackPane GridPane.columnIndex="0" styleClass="cartao">
        <VBox spacing="12.0">
            <padding>
                <Insets top="22.0" right="22.0" bottom="22.0" left="22.0"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Pacotes e ocupação" styleClass="titulo-secao"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAtualizarLista" text="Atualizar" onAction="#aoAtualizarLista"
                        styleClass="botao-secundario"/>
            </HBox>
            <TableView fx:id="tableVagas" prefHeight="460.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90.0"/>
                    <TableColumn fx:id="colDestino" text="Destino" prefWidth="210.0"/>
                    <TableColumn fx:id="colInicio" text="Início" prefWidth="100.0"/>
                    <TableColumn fx:id="colVagasTotais" text="Vagas Totais" prefWidth="100.0"/>
                    <TableColumn fx:id="colOcupadas" text="Ocupadas" prefWidth="90.0"/>
                    <TableColumn fx:id="colSituacao" text="Situação" prefWidth="110.0"/>
                </columns>
            </TableView>
        </VBox>

        <!-- FA01: nenhum pacote cadastrado -->
        <VBox fx:id="painelSemPacotes" alignment="CENTER" spacing="14.0"
              managed="false" visible="false" styleClass="painel-vazio">
            <padding>
                <Insets top="60.0" right="32.0" bottom="60.0" left="32.0"/>
            </padding>
            <Label text="Nenhum pacote cadastrado" styleClass="titulo-secao"/>
            <Label text="Cadastre ao menos um pacote de viagem para controlar a ocupação de vagas."
                   wrapText="true" textAlignment="CENTER" styleClass="texto-secundario"/>
            <Button fx:id="btnIrParaPacotes" text="Cadastrar Pacote" onAction="#aoIrParaPacotes"
                    styleClass="botao-primario"/>
        </VBox>
    </StackPane>

    <!-- Edição de capacidade (UC04, passos 5 a 8) -->
    <VBox fx:id="painelEdicao" GridPane.columnIndex="1" styleClass="cartao" spacing="14.0">
        <padding>
            <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
        </padding>

        <Label text="EDITAR CAPACIDADE" styleClass="rotulo-secao-destaque"/>
        <Label fx:id="lblPacoteSelecionado" text="Selecione um pacote na tabela"
               wrapText="true" styleClass="titulo-secao"/>
        <Label fx:id="lblCodigoPacote" text="" styleClass="codigo-pacote"/>

        <Region prefHeight="4.0"/>

        <VBox spacing="6.0">
            <Label text="Nova Capacidade Máxima" styleClass="rotulo-campo"/>
            <TextField fx:id="txtNovaCapacidade" promptText="Ex: 35"/>
            <Label fx:id="lblErroCapacidade" styleClass="mensagem-erro" wrapText="true"
                   managed="false" visible="false"/>
        </VBox>

        <VBox spacing="6.0">
            <Label text="Justificativa da Alteração" styleClass="rotulo-campo"/>
            <TextArea fx:id="txtJustificativa" prefRowCount="4" wrapText="true"
                      promptText="Ex: Alta demanda do período de feriado ou contratação de ônibus extra de turismo..."/>
            <Label fx:id="lblErroJustificativa" styleClass="mensagem-erro" wrapText="true"
                   managed="false" visible="false"/>
        </VBox>

        <VBox spacing="4.0">
            <Label fx:id="lblVagasOcupadas" text="* Vagas atualmente ocupadas: -" styleClass="nota-calculo"/>
            <Label fx:id="lblVagasLivresEstimadas" text="* Novas vagas livres estimadas: -"
                   styleClass="nota-calculo"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Button fx:id="btnSalvarAlteracao" text="Salvar Alteração" onAction="#aoSalvarAlteracao"
                maxWidth="Infinity" styleClass="botao-primario"/>
        <Button fx:id="btnCancelarAlteracao" text="Cancelar" onAction="#aoCancelarAlteracao"
                maxWidth="Infinity" styleClass="botao-secundario"/>
    </VBox>
</GridPane>
